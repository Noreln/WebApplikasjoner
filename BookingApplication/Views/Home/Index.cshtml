@{
    ViewData["Title"] = "Home Page";
}
@model BookingApplication.Models.RoomSearchViewModel

<div class="booking-search">
    <div class="container">

        <div class="text-center mb-4">
            <h1>Book a room for your next meeting</h1>
            <p class="text-muted">
                Find an available room that fits your needs.
            </p>
        </div>

        <form asp-controller="Home"
              asp-action="SearchRooms"
              method="post">
        <div asp-validation-summary="All" class="text-danger"></div>  

            <div class="row g-3 align-items-end">

                <!-- Date -->
                <div class="col-md-3">
                    <label asp-for="Date" class="form-label">
                        📅 Date
                    </label>

                    <input asp-for="Date"
                           type="date"
                           class="form-control" />
                    <span asp-validation-for="Date" class="text-danger"></span>          
                </div>

                <!-- Start time -->
                <div class="col-md-2">
                    <label asp-for="StartTime" class="form-label">
                      🕐 Start
                    </label>
                    <input asp-for="StartTime"
                    type="time"
                    class="form-control" />
                </div>

                <!-- End time -->
                <div class="col-md-2">
                    <label asp-for="EndTime" class="form-label">
                        🕐 End
                    </label>

                    <input asp-for="EndTime"
                    type="time"
                    class="form-control" />
                </div>

                <!-- People -->
                <div class="col-md-3">
                    <label asp-for="People" class="form-label">
                        👥 People
                    </label>

                    <input asp-for="People"
                           type="number"
                           min="1"
                           class="form-control" />
                    <span asp-validation-for="People" class="text-danger"></span>       
                </div>

                <!-- Search -->
                <div class="col-md-3">
                    <button type="submit"
                            class="btn btn-primary w-100">
                        🔍 Find rooms
                    </button>
                </div>

            </div>

        </form>

    </div>
</div>

@if (Model.AvailableRooms.Any())
{
    <section class="available-rooms">
        <div class="container">

            <div class="mb-4">
                <h2>Available rooms</h2>
                <p class="text-muted">
                    Rooms available for your selected time.
                </p>
            </div>

            <div class="row g-4">

                @foreach (var room in Model.AvailableRooms)
                {
                    <div class="col-md-6 col-lg-4">

                        <div class="card room-card h-100">

                            <div class="card-body">

                                <h3 class="card-title">
                                    @room.Name
                                </h3>

                                <p class="text-muted">
                                    📍 @room.Location
                                </p>

                                @if (!string.IsNullOrEmpty(room.Description))
                                {
                                    <p class="card-text">
                                        @room.Description
                                    </p>
                                }

                                <div class="room-details">

                                    <span>
                                        👥 @room.Capacity people
                                    </span>

                                </div>

                            </div>

                            <div class="card-footer bg-white border-0">
                                <a asp-controller="Booking"
                                   asp-action="Create"
                                   asp-route-roomId="@room.Id"
                                   class="btn btn-primary w-100">
                                    Book room
                                </a>
                            </div>

                        </div>

                    </div>
                }

            </div>

        </div>
    </section>
}
else
{
    <section class="available-rooms">
        <div class="container">

            <h2>Available rooms</h2>

            <p class="text-muted">
                No rooms found for your selected time.
            </p>

        </div>
    </section>
}