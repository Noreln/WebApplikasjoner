@model BookingFormViewModel
@{
  ViewData["Title"] = "Edit Booking";
}

<div class="container">
  
    <div class="text-center mb-4">
      <h1>Edit booking for @Model.RoomName</h1>
      <p class="text-muted">📍 @Model.RoomLocation &middot; capacity @Model.RoomCapacity</p>
    </div>

    <div class="row justify-content-center">
      <div class="col-md-6">
        <div class="card room-card">
          <div class="card-body">

            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
              <input type="hidden" asp-for="Id" />
              <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

              <partial name="_BookingFormFields" model="Model" />

              <button type="submit" class="btn btn-primary w-100 mt-2">Save changes</button>
              <a asp-controller="Home" asp-action="MyBookings" asp-route-name="@Model.BookedBy"
                 class="btn btn-outline-secondary w-100 mt-2">Back to my bookings</a>
            </form>

          </div>
        </div>
      </div>
    </div>
  </div>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}