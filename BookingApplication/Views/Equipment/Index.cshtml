@model List<EquipmentListItemViewModel>
@{
  ViewData["Title"] = "Equipment";
}

<div class="container">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Equipment</h1>
    <a asp-action="Create" class="btn btn-primary">+ New Equipment</a>
  </div>

  @if (Model.Count == 0)
  {
    <p class="text-muted">No equipment has been added yet.</p>
  }
  else
  {
    <div class="card room-card">
      <div class="card-body">
        <table class="table align-middle mb-0">
          <thead>
            <tr>
              <th>Name</th>
              <th>Used in</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var item in Model)
            {
              <tr>
                <td>🔧 @item.Name</td>
                <td>@item.RoomCount room(s)</td>
                <td class="text-end">
                  <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">Edit</a>
                  @if (item.IsInUse)
                  {
                    <span class="btn btn-outline-danger btn-sm disabled"
                          title="Remove it from all rooms before deleting">Delete</span>
                  }
                  else
                  {
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">Delete</a>
                  }
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  }
</div>